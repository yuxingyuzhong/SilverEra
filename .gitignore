# =============================================================================
# 白银纪元 —— 顶层仓库忽略规则
# =============================================================================

# Visual Studio 临时文件与个人设置
.vs/
*.user
*.suo
*.dbmdl
*.jfm
*.opendb
*.VC.opendb

# 构建输出目录
out/
Debug/
Release/
x64/
x86/
[Bb]in/
[Oo]bj/

# C++ 编译产物
*.obj
*.exe
*.dll
*.pdb
*.ilk
*.lib
*.exp
*.ipch
*.tlog

# 其他临时文件
*.log
*.tmp
*.cache
imgui.ini

# Cyrene agent
.cyrene/

# 各层均为独立 git 仓库（目录内含自身 .git），顶层定位为总览线、不收录各层内容；
# 不忽略时 git 会把它们当作未跟踪目录长期显示为脏改动。
Application/
Engine/EngineCore/
Engine/EngineSystem/

# glfw 预编译静态库是链接必需依赖，放行入库（例外于 *.lib 规则）
!Engine/EngineCore/external/glfw/glfw3.lib
